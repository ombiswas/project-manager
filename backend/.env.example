# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/project-manager

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# Email / SMTP Configuration (Free service: Gmail SMTP with App Password)
# For Gmail: Enable 2FA on your Google Account, then generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
FROM_EMAIL=your_email@gmail.com
